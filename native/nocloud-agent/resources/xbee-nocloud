#!/usr/bin/env bash
set -euo pipefail

# Shared by the monolithic and package-assembled NoCloud images.
admin_user=${XBEE_NOCLOUD_USER:-xbee}
state_dir=/var/lib/xbee-nocloud
seed_mount=/run/xbee-nocloud
log() {
  printf 'xbee-nocloud: %s\n' "$*"
}

grow_rootfs() {
  local root_partition root_disk parent partition_number
  local disk_bytes partition_bytes partition_start

  root_partition=$(findmnt -n -o SOURCE / 2>/dev/null || true)
  root_partition=$(readlink -f "$root_partition" 2>/dev/null || true)
  parent=$(lsblk -ndo PKNAME "$root_partition" 2>/dev/null || true)
  partition_number=$(lsblk -ndo PARTN "$root_partition" 2>/dev/null || true)
  root_disk=${parent:+/dev/$parent}

  if [[ -z "$root_disk" || -z "$partition_number" ||
        ! -b "$root_disk" || ! -b "$root_partition" ]]; then
    log "cannot identify the root partition; skipping automatic resize"
    return
  fi

  disk_bytes=$(blockdev --getsize64 "$root_disk" 2>/dev/null || true)
  partition_bytes=$(blockdev --getsize64 "$root_partition" 2>/dev/null || true)
  partition_start=$(lsblk -bndo START "$root_partition" 2>/dev/null || true)
  if [[ "$disk_bytes" =~ ^[0-9]+$ &&
        "$partition_bytes" =~ ^[0-9]+$ &&
        "$partition_start" =~ ^[0-9]+$ ]] &&
      ((partition_start * 512 + partition_bytes >= disk_bytes)); then
    log "root partition already occupies the disk"
    return
  fi

  # sfdisk may be unable to make the running kernel reread a mounted root
  # partition. partx performs the update afterwards; both operations are
  # harmless when the partition already occupies the whole disk.
  printf ',+\n' | sfdisk --no-reread --force \
    -N "$partition_number" "$root_disk" >/dev/null
  partx --update --nr "$partition_number" "$root_disk" 2>/dev/null || true
  resize2fs "$root_partition"
}

find_seed_device() {
  local device label
  device=$(blkid -L cidata 2>/dev/null || true)
  if [[ -n "$device" ]]; then
    printf '%s\n' "$device"
    return
  fi
  for device in /dev/sr0 /dev/sr1; do
    [[ -b "$device" ]] || continue
    label=$(blkid -s LABEL -o value "$device" 2>/dev/null || true)
    if [[ "${label,,}" == cidata ]]; then
      printf '%s\n' "$device"
      return
    fi
  done
}

valid_key() {
  [[ "$1" =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521))[[:space:]][A-Za-z0-9+/=]+([[:space:]].*)?$ ]]
}

metadata_value() {
  local key=$1
  local file=$2
  sed -n "s/^[[:space:]]*$key:[[:space:]]*//p" "$file" | head -n 1
}

password_hash_value() {
  local value
  value=$(metadata_value password_hash "$1")
  if [[ "$value" == \"*\" && "$value" == *\" ]] ||
     [[ "$value" == \'* && "$value" == *\' ]]; then
    value=${value:1:${#value}-2}
  fi
  printf '%s\n' "$value"
}

valid_password_hash() {
  [[ "$1" =~ ^\$y\$[./A-Za-z0-9]+\$[./A-Za-z0-9]+\$[./A-Za-z0-9]+$ ||
     "$1" =~ ^\$6\$(rounds=[0-9]+\$)?[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}$ ]]
}

install_password_hash() {
  local file=$1
  local password_hash

  [[ -f "$file" ]] || return 0
  password_hash=$(password_hash_value "$file")
  [[ -n "$password_hash" ]] || return 0
  if ! valid_password_hash "$password_hash"; then
    log "password_hash is not a supported crypt hash"
    return 1
  fi
  usermod --password "$password_hash" "$admin_user"
  log "installed a hashed password for user $admin_user"
}

collect_user_data_keys() {
  local file=$1
  awk '
    /^ssh_authorized_keys:[[:space:]]*$/ { in_keys=1; next }
    in_keys && /^[[:space:]]*-[[:space:]]+/ {
      sub(/^[[:space:]]*-[[:space:]]+/, "")
      gsub(/^["'\'']|["'\'']$/, "")
      print
      next
    }
    in_keys && /^[^[:space:]#]/ { in_keys=0 }
  ' "$file"
}

collect_metadata_keys() {
  local file=$1
  awk '
    /^public-keys:[[:space:]]*$/ { in_keys=1; next }
    in_keys && /^[[:space:]]+[^:]+:[[:space:]]+/ {
      sub(/^[[:space:]]+[^:]+:[[:space:]]+/, "")
      gsub(/^["'\'']|["'\'']$/, "")
      print
      next
    }
    in_keys && /^[^[:space:]#]/ { in_keys=0 }
  ' "$file"
}

install_keys() {
  local metadata=$1
  local user_data=$2
  local home uid gid key
  local key_file

  home=$(getent passwd "$admin_user" | cut -d: -f6)
  uid=$(id -u "$admin_user")
  gid=$(id -g "$admin_user")
  install -d -m 0700 -o "$uid" -g "$gid" "$home/.ssh"
  key_file=$(mktemp "$state_dir/authorized_keys.XXXXXX")

  while IFS= read -r key; do
    if valid_key "$key"; then
      printf '%s\n' "$key" >>"$key_file"
    fi
  done < <(
    [[ -f "$user_data" ]] && collect_user_data_keys "$user_data"
    [[ -f "$metadata" ]] && collect_metadata_keys "$metadata"
  )

  if [[ ! -s "$key_file" ]]; then
    unlink "$key_file"
    log "seed contains no supported SSH public key"
    return 1
  fi
  sort -u "$key_file" -o "$key_file"
  chmod 0600 "$key_file"
  chown "$uid:$gid" "$key_file"
  mv "$key_file" "$home/.ssh/authorized_keys"
}

apply_cloud_config() {
  local file=$1
  local content path command

  [[ -f "$file" ]] || return 0
  content=$(sed -n \
    's/^[[:space:]]*content:[[:space:]]*//p' "$file" | head -n 1)
  path=$(sed -n \
    's/^[[:space:]]*path:[[:space:]]*//p' "$file" | head -n 1)

  if [[ -n "$content" || -n "$path" ]]; then
    if [[ -z "$content" || ! "$path" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
      log "unsupported write_files entry"
      return 1
    fi
    install -d -m 0755 "$(dirname "$path")"
    printf '%s' "$content" | base64 -d >"$path"
    chmod 0600 "$path"
  fi

  while IFS= read -r command; do
    command=${command#*- }
    if [[ "$command" =~ ^bash[[:space:]]+(/[A-Za-z0-9._/-]+)$ ]]; then
      bash "${BASH_REMATCH[1]}"
    else
      log "unsupported runcmd entry: $command"
      return 1
    fi
  done < <(awk '
    /^runcmd:[[:space:]]*$/ { in_runcmd=1; next }
    in_runcmd && /^[[:space:]]*-[[:space:]]+/ { print; next }
    in_runcmd && /^[^[:space:]#]/ { in_runcmd=0 }
  ' "$file")
}

mkdir -p "$state_dir" "$seed_mount"
grow_rootfs

seed_device=$(find_seed_device || true)
if [[ -z "$seed_device" ]]; then
  log "no cidata volume found; leaving remote access disabled"
  exit 0
fi

mount -o ro "$seed_device" "$seed_mount"
trap 'umount "$seed_mount" 2>/dev/null || true' EXIT

metadata="$seed_mount/meta-data"
user_data="$seed_mount/user-data"
instance_id=
hostname=
[[ -f "$metadata" ]] && instance_id=$(metadata_value instance-id "$metadata")
[[ -f "$metadata" ]] && hostname=$(metadata_value local-hostname "$metadata")
[[ -z "$hostname" && -f "$user_data" ]] && hostname=$(metadata_value hostname "$user_data")
[[ -n "$instance_id" ]] || instance_id=cidata-unknown

if [[ -f "$state_dir/instance-id" ]] && [[ "$(<"$state_dir/instance-id")" == "$instance_id" ]]; then
  log "instance $instance_id is already configured"
  exit 0
fi

if [[ -n "$hostname" && "$hostname" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]]; then
  hostname "$hostname"
  printf '%s\n' "$hostname" >/etc/hostname
fi

apply_cloud_config "$user_data"
install_password_hash "$user_data"
install_keys "$metadata" "$user_data" || true
if [[ ! -s "$(getent passwd "$admin_user" | cut -d: -f6)/.ssh/authorized_keys" ]]; then
  log "provisioning did not install an SSH public key"
  exit 1
fi
rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub
ssh-keygen -A
printf '%s\n' "$instance_id" >"$state_dir/instance-id"
install -d -m 0755 /var/lib/cloud/instance
touch /var/lib/cloud/instance/boot-finished
log "configured instance $instance_id for user $admin_user"
